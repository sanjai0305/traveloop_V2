# =========================================
# MySQL Database Configuration
# =========================================
DB_HOST=localhost
DB_PORT=3306
DB_NAME=traveloop
DB_USER=traveloop_app
DB_PASSWORD=your_secure_mysql_password
DB_SSL=false

# =========================================
# Firebase Admin Credentials
# =========================================
FIREBASE_PROJECT_ID=your-project-id
FIREBASE_CLIENT_EMAIL=your-service-account-email
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nYOUR_PRIVATE_KEY\n-----END PRIVATE KEY-----\n"
FIREBASE_CLIENT_ID=
FIREBASE_TEST_PHONE_NUMBER=+911234567890
FIREBASE_TEST_PHONE_OTP=123456

# =========================================
# Google APIs
# =========================================
GOOGLE_MAPS_API_KEY=
GOOGLE_PLACES_API_KEY=
GEMINI_API_KEY=

# =========================================
# Gmail / Email
# =========================================
GOOGLE_SENDER_EMAIL=
GMAIL_CLIENT_ID=
GMAIL_CLIENT_SECRET=
GMAIL_REFRESH_TOKEN=
GMAIL_REDIRECT_URI=
EMAIL_FROM=

# =========================================
# Payments
# =========================================
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_SECRET=

# =========================================
# AWS S3 Storage Configuration (Media & Documents)
# =========================================
AWS_REGION=ap-south-1
AWS_S3_BUCKET=your-unique-traveloop-bucket-name
AWS_CLOUDFRONT_DOMAIN=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_SESSION_TOKEN=

# =========================================
# Internal Services & Cache
# =========================================
AI_SERVICE_URL=http://localhost:8000
REDIS_URL=redis://localhost:6379

# =========================================
# Initial Admin Bootstrapping
# =========================================
ADMIN_NAME=Super Admin
ADMIN_EMAIL=admin@traveloop.in
ADMIN_PASSWORD=your-secure-admin-password

# =========================================
# Application
# =========================================
PORT=5000
NODE_ENV=development
JWT_SECRET=your-jwt-secret
FRONTEND_URL=http://localhost:5173
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:3000,http://localhost:3001,http://localhost:3002,http://localhost:3003
AVIATIONSTACK_API_KEY=
DRIVER_QR_SECRET=
