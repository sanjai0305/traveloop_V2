FIREBASE_TEST_PHONE_OTP=123456
FIREBASE_DATABASE_URL=
FIREBASE_STORAGE_BUCKET=

# =========================================
# Google APIs
# =========================================
GOOGLE_MAPS_API_KEY=
GOOGLE_PLACES_API_KEY=
GEMINI_API_KEY=

# =========================================
# Gmail / Email
# =========================================
GOOGLE_SENDER_EMAIL=
GMAIL_CLIENT_ID=
GMAIL_CLIENT_SECRET=
GMAIL_REFRESH_TOKEN=
GMAIL_REDIRECT_URI=
EMAIL_FROM=

# =========================================
# Payments
# =========================================
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_SECRET=

# =========================================
# Cloudinary (Media & KYC Document Storage)
# =========================================
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# =========================================
# Internal Services & Cache
# =========================================
AI_SERVICE_URL=http://localhost:8000
REDIS_URL=redis://localhost:6379

# =========================================
# Initial Admin Bootstrapping
# =========================================
ADMIN_NAME=Super Admin
ADMIN_EMAIL=admin@traveloop.in
ADMIN_PASSWORD=your-secure-admin-password

# =========================================
# Application
# =========================================
PORT=5000
NODE_ENV=development
JWT_SECRET=your-jwt-secret
FRONTEND_URL=http://localhost:5173
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:3000,http://localhost:3001,http://localhost:3002,http://localhost:3003
