VITE_API_URL=http://localhost:5000/api
VITE_SOCKET_URL=http://localhost:5000

# ── Demo / Development Mode ───────────────────────────────────────────────────
# Set to "true" to enable fully isolated demo mode (no backend required).
# In demo mode:
#   - ANY email and password are accepted.
#   - A random 6-digit OTP is generated locally and shown on screen.
#   - All dashboard data uses local mock data.
#   - No HTTP requests are made to the backend.
#   - Logout clears localStorage and returns to /login.
# Set to "false" or remove to restore the real email+OTP authentication flow.
VITE_DEMO_MODE=true
